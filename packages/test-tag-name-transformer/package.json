{
	"name": "@public-ui/test-tag-name-transformer",
	"private": true,
	"scripts": {
		"prepare": "npm-run-all2 prepare:snapshots prepare:assets",
		"prepare:snapshots": "cpy \"../themes/default/snapshots\" ./ --dot",
		"prepare:assets": "cpy \"node_modules/@public-ui/theme-default/assets/**/*\" ./assets --dot",
		"test": "cross-env THEME_MODULE=theme ENABLE_TAG_NAME_TRANSFORMER=true kolibri-visual-test"
	},
	"devDependencies": {
		"@public-ui/theme-default": "workspace:*",
		"@public-ui/visual-tests": "workspace:*",
		"cpy-cli": "7.0.0",
		"cross-env": "10.1.0",
		"npm-run-all2": "8.0.4"
	}
}
