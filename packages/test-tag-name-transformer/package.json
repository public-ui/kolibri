{
	"name": "@public-ui/test-tag-name-transformer",
	"private": true,
	"scripts": {
		"pretest": "npm-run-all2 build:theme prepare:snapshots prepare:assets prepare:theme prepare:css",
		"build:theme": "pnpm --filter @public-ui/theme-default... build",
		"prepare:snapshots": "cpy \"../themes/default/snapshots\" ./ --dot",
		"prepare:assets": "kolibri-copy-assets --dest assets @public-ui/theme-default",
		"prepare:theme": "kolibri-copy-assets --dest theme @public-ui/theme-default:dist",
		"prepare:css": "cpy \"../themes/default/inject-assets.css\" ./ --dot",
		"test": "cross-env THEME_MODULE=theme THEME_EXPORT=DEFAULT THEME_CSS=$(pwd)/inject-assets.css ENABLE_TAG_NAME_TRANSFORMER=true kolibri-visual-test"
	},
	"devDependencies": {
		"@public-ui/theme-default": "workspace:*",
		"@public-ui/visual-tests": "workspace:*",
		"cpy-cli": "7.0.0",
		"cross-env": "10.1.0",
		"npm-run-all2": "9.0.3"
	}
}
