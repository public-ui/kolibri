{
	"name": "@public-ui/theme-itzbund",
	"version": "2.1.3",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "rollup -c",
		"build:deps": "pnpm --filter @public-ui/theme-itzbund^... build",
		"dev": "rollup -c --watch",
		"format": "prettier --check src",
		"lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:tsc",
		"lint:eslint": "eslint src",
		"lint:stylelint": "stylelint \"src/**/*.{css,scss}\"",
		"lint:tsc": "tsc --noemit",
		"prepare": "cpy \"node_modules/@public-ui/components/assets/**/*\" assets --dot",
		"start": "npm-run-all2 --parallel dev serve",
		"serve": "cross-env THEME_MODULE=\"`pwd`/dist\" THEME_EXPORT=ITZBund npm --prefix \"node_modules/@public-ui/visual-tests/node_modules/@public-ui/sample-react/\" start",
		"xtest": "cross-env THEME_MODULE=dist THEME_EXPORT=ITZBund kolibri-visual-test",
		"xtest-update": "cross-env THEME_MODULE=dist THEME_EXPORT=ITZBund kolibri-visual-test --update-snapshots=changed theme-snapshots.spec.js",
		"pretest": "pnpm build",
		"pretest-update": "pnpm build"
	},
	"devDependencies": {
		"@public-ui/components": "workspace:*",
		"@public-ui/visual-tests": "workspace:*",
		"@rollup/plugin-commonjs": "28.0.9",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-typescript": "12.3.0",
		"@typescript-eslint/eslint-plugin": "7.18.0",
		"@typescript-eslint/parser": "7.18.0",
		"autoprefixer": "10.5.0",
		"cpy-cli": "6.0.0",
		"cross-env": "10.1.0",
		"eslint": "8.57.1",
		"nodemon": "3.1.14",
		"npm-run-all2": "8.0.4",
		"postcss": "8.5.15",
		"rollup": "4.60.4",
		"rollup-plugin-postcss": "4.0.2",
		"sass-embedded": "1.99.0",
		"typescript": "5.9.3",
		"unbuild": "3.6.1"
	},
	"peerDependencies": {
		"@public-ui/components": "workspace:*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"assets",
		"dist"
	]
}
