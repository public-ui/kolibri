{
	"name": "@public-ui/theme-default",
	"version": "2.2.22",
	"license": "EUPL-1.2",
	"homepage": "https://public-ui.github.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"bugs": {
		"url": "https://github.com/public-ui/kolibri/issues",
		"email": "kolibri@itzbund.de"
	},
	"author": {
		"name": "Informationstechnikzentrum Bund",
		"email": "kolibri@itzbund.de"
	},
	"description": "Contains the default theme for KoliBri - The accessible HTML-Standard.",
	"keywords": [
		"accessibility",
		"accessible",
		"bitv",
		"designsystem",
		"design",
		"web components",
		"webcomponents",
		"aria",
		"wai",
		"axe",
		"custom elements",
		"styleguide",
		"style",
		"guide",
		"ui",
		"html",
		"css",
		"web",
		"a11y",
		"w3c",
		"webstandard",
		"wcag"
	],
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "rollup -c",
		"build:deps": "pnpm --filter @public-ui/theme-default^... build",
		"dev": "rollup -c --watch",
		"format": "prettier --check src",
		"lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:tsc",
		"lint:eslint": "eslint src",
		"lint:stylelint": "stylelint \"src/**/*.{css,scss}\"",
		"lint:tsc": "tsc --noemit",
		"prepare": "cpy \"node_modules/@public-ui/components/assets/**/*\" assets --dot",
		"start": "npm-run-all2 --parallel dev serve",
		"serve": "sh serve.sh DEFAULT",
		"test": "cross-env THEME_MODULE=dist THEME_EXPORT=DEFAULT kolibri-visual-test",
		"test-update": "cross-env THEME_MODULE=dist THEME_EXPORT=DEFAULT kolibri-visual-test --update-snapshots=changed theme-snapshots.spec.js",
		"pretest": "pnpm build",
		"pretest-update": "pnpm build"
	},
	"devDependencies": {
		"@public-ui/components": "workspace:*",
		"@public-ui/visual-tests": "workspace:*",
		"@rollup/plugin-commonjs": "28.0.9",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-typescript": "12.3.0",
		"@typescript-eslint/eslint-plugin": "7.18.0",
		"@typescript-eslint/parser": "7.18.0",
		"autoprefixer": "10.4.27",
		"cpy-cli": "6.0.0",
		"cross-env": "10.1.0",
		"eslint": "8.57.1",
		"nodemon": "3.1.14",
		"npm-run-all2": "8.0.4",
		"postcss": "8.5.8",
		"rollup": "4.59.0",
		"rollup-plugin-postcss": "4.0.2",
		"sass-embedded": "1.98.0",
		"typescript": "5.9.3",
		"unbuild": "3.6.1"
	},
	"peerDependencies": {
		"@public-ui/components": "workspace:*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"assets",
		"dist"
	]
}
