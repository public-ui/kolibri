{
	"name": "@public-ui/theme-ecl",
	"version": "4.1.5-rc.0",
	"license": "EUPL-1.2",
	"homepage": "https://public-ui.github.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"bugs": {
		"url": "https://github.com/public-ui/kolibri/issues",
		"email": "kolibri@itzbund.de"
	},
	"author": {
		"name": "Informationstechnikzentrum Bund",
		"email": "kolibri@itzbund.de"
	},
	"description": "Contains the default theme for KoliBri - The accessible HTML-Standard.",
	"keywords": [
		"accessibility",
		"accessible",
		"bitv",
		"designsystem",
		"design",
		"web components",
		"webcomponents",
		"aria",
		"wai",
		"axe",
		"custom elements",
		"styleguide",
		"style",
		"guide",
		"ui",
		"html",
		"css",
		"web",
		"a11y",
		"w3c",
		"webstandard",
		"wcag"
	],
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"assets:all": "npm-run-all2 assets:components assets:ecl-icons",
		"assets:components": "cpy \"node_modules/@public-ui/components/assets/**/*\" assets --dot",
		"assets:ecl-icons": "pnpm --filter @public-ui/ecl-icons build",
		"build": "rollup -c",
		"dev": "rollup -c --watch",
		"format": "prettier --check src",
		"lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:tsc",
		"lint:eslint": "eslint src",
		"lint:stylelint": "stylelint \"src/**/*.{css,scss}\"",
		"lint:tsc": "tsc --noemit",
		"prebuild": "pnpm assets:all",
		"prepare": "pnpm assets:all",
		"start:ec": "npm-run-all2 --parallel dev serve:ec",
		"start:eu": "npm-run-all2 --parallel dev serve:eu",
		"serve:ec": "sh serve.sh ECL_EC",
		"serve:eu": "sh serve.sh ECL_EU",
		"test": "npm-run-all2 test:theme:ecl-ec",
		"test:theme:ecl-ec": "cross-env THEME_MODULE=dist THEME_EXPORT=ECL_EC THEME_CSS=$(pwd)/inject-assets.css kolibri-visual-test",
		"test:theme:ecl-eu": "cross-env THEME_MODULE=dist THEME_EXPORT=ECL_EU THEME_CSS=$(pwd)/inject-assets.css kolibri-visual-test",
		"test:update:e2e": "npm-run-all2 build test:update:theme:ecl-ec",
		"test:update:theme:ecl-ec": "cross-env THEME_MODULE=dist THEME_EXPORT=ECL_EC THEME_CSS=$(pwd)/inject-assets.css kolibri-visual-test --update-snapshots=changed theme-snapshots.spec.js",
		"test:update:theme:ecl-eu": "cross-env THEME_MODULE=dist THEME_EXPORT=ECL_EU THEME_CSS=$(pwd)/inject-assets.css kolibri-visual-test --update-snapshots=changed theme-snapshots.spec.js",
		"pretest": "pnpm build",
		"pretest:update": "pnpm build"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.5",
		"@eslint/js": "9.39.4",
		"@public-ui/components": "workspace:*",
		"@public-ui/stylelint-rules": "workspace:*",
		"@public-ui/visual-tests": "workspace:*",
		"@rollup/plugin-commonjs": "29.0.2",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-typescript": "12.3.0",
		"@typescript-eslint/eslint-plugin": "8.58.2",
		"@typescript-eslint/parser": "8.58.2",
		"autoprefixer": "10.5.0",
		"cpy-cli": "6.0.0",
		"cross-env": "10.1.0",
		"eslint": "9.39.4",
		"nodemon": "3.1.14",
		"npm-run-all2": "8.0.4",
		"postcss": "8.5.14",
		"prettier": "3.8.3",
		"prettier-plugin-organize-imports": "4.3.0",
		"rollup": "4.60.3",
		"rollup-plugin-postcss": "4.0.2",
		"sass-embedded": "1.99.0",
		"stylelint": "17.11.0",
		"typescript": "5.9.3",
		"unbuild": "3.6.1"
	},
	"peerDependencies": {
		"@public-ui/components": "workspace:*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"assets",
		"dist"
	]
}
