exports[`FieldControlFC renders a hidden label as tooltip 1`] = `
<div class="kol-field-control kol-field-control--hide-label">
  <div class="kol-field-control__input">
    <input>
  </div>
  <div class="kol-form-field__tooltip">
    <div class="kol-tooltip__floating">
      <div class="kol-tooltip__arrow"></div>
      <span class="kol-span kol-tooltip__content" id="id-label">
        <span class="kol-span__container">
          <span class="kol-span__label">
            Label
          </span>
          <span aria-hidden="true" class="kol-span__slot" hidden=""></span>
        </span>
      </span>
    </div>
  </div>
  <label class="kol-field-control__label kol-field-control__label--visually-hidden" htmlfor="id" id="id-label">
    <span class="kol-field-control__label-text kol-span">
      <span class="kol-span__container">
        <span class="kol-span__label">
          Label
        </span>
        <span aria-hidden="true" class="kol-span__slot" hidden=""></span>
      </span>
    </span>
  </label>
</div>
`;

