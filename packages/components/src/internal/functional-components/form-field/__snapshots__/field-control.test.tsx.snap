exports[`CheckboxFC renders disabled with a touched error 1`] = `
<label class="kol-checkbox kol-checkbox--disabled kol-checkbox--error kol-checkbox--touched kol-checkbox--variant-default">
  <i aria-hidden="true" class="kol-checkbox__icon kol-icon kol-icon__icon kolicon-check" role="presentation"></i>
  <input autocapitalize="off" autocorrect="off" class="kol-checkbox__input kol-input kol-input--disabled kol-input--error kol-input--touched" disabled="" id="id" type="checkbox">
</label>
`;

