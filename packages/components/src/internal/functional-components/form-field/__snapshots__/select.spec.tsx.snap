exports[`SelectFC forwards disabled to optgroups and options when select is disabled 1`] = `
<select autocapitalize="off" autocorrect="off" class="kol-select kol-select--disabled" disabled="" id="test">
  <optgroup class="kol-select__optgroup kol-select__optgroup--disabled" disabled="" label="Group 1">
    <option class="kol-select__option kol-select__option--disabled" disabled="" value="-0-0">
      Option 1
    </option>
  </optgroup>
</select>
`;

exports[`SelectFC renders a hidden label and descriptions 1`] = `
