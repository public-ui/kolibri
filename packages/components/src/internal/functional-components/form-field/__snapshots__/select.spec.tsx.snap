  <option class="kol-select__option" value="-0">
    Eins
  </option>
  <optgroup class="kol-select__optgroup" label="Gruppe">
    <option class="kol-select__option" value="-1-0">
      Zwei
    </option>
    <option class="kol-select__option kol-select__option--disabled" disabled="" value="-1-1">
      Drei
    </option>
  </optgroup>
</select>
`;

