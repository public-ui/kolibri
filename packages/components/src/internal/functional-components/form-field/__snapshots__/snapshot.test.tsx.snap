  </div>
</div>
`;

exports[`FormFieldFC renders a hidden label shown as tooltip 1`] = `
<div class="kol-form-field kol-form-field--hide-label">
  <label class="kol-form-field__label" hidden="" htmlfor="field-nonce">
    <span class="kol-form-field__label-text kol-span kol-span--has-badge">
      <span class="kol-span__container">
        <span class="kol-span__label">
          L
          <u>
            a
          </u>
          bel
        </span>
        <span aria-hidden="true" class="kol-span__slot" hidden=""></span>
        <kbd aria-hidden="true" class="badge-text-hint">
          A
        </kbd>
      </span>
    </span>
  </label>
  <div class="kol-form-field__input">
    <input type="text">
    <div class="kol-form-field__tooltip">
      <div class="kol-tooltip__floating">
        <div class="kol-tooltip__arrow"></div>
        <span class="kol-span kol-span--has-badge kol-tooltip__content" id="field-label-nonce">
          <span class="kol-span__container">
            <span class="kol-span__label">
              L
              <u>
                a
              </u>
              bel
            </span>
            <span aria-hidden="true" class="kol-span__slot" hidden=""></span>
            <kbd aria-hidden="true" class="badge-text-hint">
              A
            </kbd>
          </span>
        </span>
      </div>
    </div>
  </div>
</div>
`;

