exports[`FormFieldFC renders a character limit hint 1`] = `
<div class="kol-form-field">
  <label class="kol-form-field__label" htmlfor="field-nonce" id="field-label-nonce">
    <span class="kol-form-field__label-text kol-span">
      <span class="kol-span__container">
        <span class="kol-span__label">
          Label
        </span>
        <span aria-hidden="true" class="kol-span__slot" hidden=""></span>
      </span>
    </span>
  </label>
  <div class="kol-form-field__input">
    <input type="text">
  </div>
  <span class="visually-hidden" id="field-character-limit-hint-nonce">
    kol-character-limit-hint
  </span>
</div>
`;

exports[`FormFieldFC renders a counter 1`] = `
<div class="kol-form-field">
  <label class="kol-form-field__label" htmlfor="field-nonce" id="field-label-nonce">
