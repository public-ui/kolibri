          </caption>
          <thead class="kol-table__head">
            <tr class="kol-table__head-row">
              <th class="kol-table__cell kol-table__cell--header kol-table__cell--selection" scope="col">
                <span class="visually-hidden">
                  kol-table-selection
                </span>
                <div class="kol-table__selection kol-table__selection--indeterminate">
                  <label class="kol-table__selection-label">
                    <i aria-hidden="true" class="kol-icon kol-icon__icon kol-table__selection-icon kolicon kolicon-minus" role="presentation"></i>
                    <input aria-label="kol-table-selection-indeterminate" class="kol-table__selection-input kol-table__selection-input--checkbox" indeterminate="" name="selection" type="checkbox">
                  </label>
                  <div class="kol-table__selection-input-tooltip">
