                          <span aria-hidden="true" class="kol-span__slot" hidden=""></span>
                        </span>
                      </span>
                    </div>
                  </div>
                </div>
              </th>
              <th aria-sort="none" class="kol-table__cell kol-table__cell--header kol-table__cell--none" data-sort="sort-NOS" scope="col">
                <span class="kol-table__sort">
                  <div class="kol-button kol-button--normal kol-button--standalone kol-table__sort-button">
                    <button aria-describedby="nonce" class="kol-button__interactive-element" type="button">
                      <span class="kol-button__text kol-span">
                        <span class="kol-span__container">
                          <span class="kol-span__label">
                            ID
                          </span>
                          <span aria-hidden="true" class="kol-span__slot" hidden="">
                            <slot name="expert" slot="expert"></slot>
                          </span>
                          <i aria-hidden="true" class="kol-icon kol-icon__icon kol-span__icon kol-span__icon--right kolicon-sort-neutral" role="presentation"></i>
                        </span>
                      </span>
                    </button>
                    <span class="visually-hidden" id="nonce">
                      kol-sort
                    </span>
                  </div>
                </span>
