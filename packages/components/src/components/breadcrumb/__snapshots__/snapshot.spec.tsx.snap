        <li class="kol-breadcrumb__list-element">
          <div class="kol-breadcrumb__link">
            <div class="kol-link kol-link--standalone">
              <a class="kol-link__interactive-element" href="https://example.com">
                <span class="kol-link__text kol-span">
                  <span class="kol-span__container">
                    <span class="kol-span__label">
                      Label 1
                    </span>
                    <span aria-hidden="true" class="kol-span__slot" hidden="">
                      <slot name="expert" slot="expert"></slot>
                    </span>
                  </span>
                </span>
              </a>
            </div>
          </div>
          <i aria-hidden="true" class="kol-breadcrumb__separator kol-icon kol-icon__icon kolicon-chevron-right" role="presentation"></i>
        </li>
        <li class="kol-breadcrumb__list-element">
          <span aria-current="page" class="kol-breadcrumb__list-element-span">
            Label 2
          </span>
        </li>
      </ul>
    </nav>
  </template>
</kol-breadcrumb>
`;

