exports[`kol-breadcrumb should render with _label="Aria-Label" _links=[{"_href":"https://example.com","_label":"Label 1"},{"_href":"https://example.com","_label":"Label 2"}] 1`] = `
<kol-breadcrumb>
  <template shadowrootmode="open">
    <nav aria-label="Aria-Label" class="kol-breadcrumb">
