  <template shadowrootmode="open">
    <div class="kol-alert kol-alert--type-default kol-alert--variant-msg" role="alert">
      <span class="visually-hidden">
        kol-message
      </span>
      <i aria-hidden="true" class="kol-alert__icon kol-icon kol-icon__icon kolicon-alert-info" role="presentation"></i>
      <h4 class="kol-alert__heading kol-alert__heading--h4 kol-headline kol-headline--h4 kol-headline--single" id="alert-heading-nonce">
        Überschrift
      </h4>
      <div aria-describedby="alert-heading-nonce" class="kol-alert__content">
        <slot></slot>
      </div>
    </div>
  </template>
</kol-alert>
`;

