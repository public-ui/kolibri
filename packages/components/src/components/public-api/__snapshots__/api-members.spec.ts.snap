      "doc": "Focus handler bound to the button element. Implemented by the web component, which also dispatches the custom \`KolEvent.focus\` event on the host element.",
      "type": "(event: FocusEvent) => void",
    },
    "mouseDown": {
      "doc": "Mousedown handler bound to the button element. Implemented by the web component, which also dispatches the custom \`KolEvent.mousedown\` event on the host element.",
      "type": "(event: MouseEvent) => void",
    },
