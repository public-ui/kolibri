{
	"src/**/*.{css,scss}": [
		"stylelint --fix"
	],
	"src/**/*.{ts,tsx,js,jsx}": [
		"prettier --list-different",
		"eslint --max-warnings=0 --cache --cache-location=node_modules/.cache/eslint"
	],
	"!(assets)/**/*.{md,css,scss}": "prettier --list-different",
	"*.{md,css,scss}": "prettier --list-different"
}