{
	"name": "@public-ui/sample-react",
	"version": "2.2.11-rc.1",
	"description": "This app contains samples for the KoliBri/Public UI",
	"license": "EUPL-1.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"scripts": {
		"build": "rimraf dist && cross-env NODE_ENV=production webpack",
		"build:deps": "pnpm --filter @public-ui/sample-react^... build",
		"format": "prettier --check src",
		"lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:tsc",
		"lint:eslint": "eslint src",
		"lint:stylelint": "stylelint \"src/**/*.{css,scss}\"",
		"lint:tsc": "tsc --noemit",
		"prepare": "npm-run-all prepare:*",
		"prepare:components-assets": "cpy \"node_modules/@public-ui/components/assets/**/*\" public/assets --dot",
		"prepare:themes-assets": "cpy \"node_modules/@public-ui/themes/assets/**/*\" public/assets --dot",
		"postinstall": "pnpm exec playwright install",
		"serve": "cross-env NODE_ENV=development webpack serve --devtool=source-map",
		"start": "npm run serve -- --open",
		"test:e2e": "playwright test",
		"test": "pnpm test:e2e",
		"unused": "knip"
	},
	"dependencies": {
		"@leanup/stack": "1.3.54",
		"@leanup/stack-react": "1.3.54",
		"@leanup/stack-webpack": "1.3.54",
		"@playwright/test": "1.49.1",
		"@public-ui/components": "workspace:*",
		"@public-ui/react": "workspace:*",
		"@public-ui/themes": "workspace:*",
		"@stencil/core": "4.20.0",
		"@types/node": "^22.14.1",
		"@types/react": "18.3.4",
		"@types/react-dom": "18.3.5",
		"@unocss/preset-uno": "0.58.9",
		"@unocss/webpack": "0.58.9",
		"adopted-style-sheets": "1.1.8",
		"ajv": "8.17.1",
		"cpy-cli": "5.0.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react": "7.37.4",
		"formik": "2.4.6",
		"knip": "5.53.0",
		"npm-run-all2": "7.0.2",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-number-format": "5.4.3",
		"react-router": "6.30.0",
		"react-router-dom": "6.30.0",
		"rimraf": "6.0.1",
		"stylelint": "16.17.0",
		"stylelint-config-recommended-scss": "14.1.0",
		"stylelint-config-standard": "37.0.0",
		"stylelint-scss": "6.11.1",
		"tslib": "2.8.1",
		"typescript": "5.8.2",
		"world_countries_lists": "2.9.0",
		"yup": "1.6.1"
	},
	"files": [
		".eslintignore",
		".eslintrc.js",
		".gitignore",
		".prettierignore",
		"dist/**",
		"prettier.config.js",
		"public/**",
		"src/**",
		"test-build.sh",
		"tsconfig.json",
		"unocss.config.ts",
		"webpack.config.js"
	]
}
