{
	"name": "@public-ui/sample-react",
	"version": "4.3.0-rc.1",
	"description": "This app contains samples for the KoliBri/Public UI",
	"type": "module",
	"license": "EUPL-1.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"scripts": {
		"build": "vite build",
		"build:deps": "pnpm --filter @public-ui/sample-react^... build",
		"format": "prettier --check src",
		"lighthouse": "lhci autorun",
		"lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:tsc",
		"lint:eslint": "eslint src",
		"lint:stylelint": "stylelint \"src/**/*.{css,scss}\"",
		"lint:tsc": "tsc --noemit",
		"prebuild": "kolibri-copy-assets --dest public/assets @public-ui/components @public-ui/themes",
		"preserve": "pnpm prebuild",
		"prestart": "pnpm prebuild",
		"serve": "vite",
		"start": "vite --open",
		"test:e2e": "playwright test",
		"unused": "knip"
	},
	"dependencies": {
		"@hookform/resolvers": "5.4.0",
		"@public-ui/components": "workspace:*",
		"@public-ui/react-hook-form-adapter": "workspace:*",
		"@public-ui/react-v19": "workspace:*",
		"@public-ui/themes": "workspace:*",
		"@stencil/core": "4.38.3",
		"@types/node": "25.9.3",
		"@types/papaparse": "5.5.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@unocss/preset-mini": "66.7.2",
		"@unocss/vite": "66.7.2",
		"@vitejs/plugin-react-swc": "4.3.1",
		"adopted-style-sheets": "1.1.9-rc.22",
		"papaparse": "5.5.3",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "7.79.0",
		"react-number-format": "5.4.5",
		"react-router": "7.17.0",
		"react-router-dom": "7.17.0",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"vite": "7.3.5",
		"world_countries_lists": "3.3.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@lhci/cli": "0.15.1",
		"@playwright/test": "1.60.0",
		"@public-ui/eslint-config": "workspace:*",
		"eslint": "9.39.4",
		"http-server": "14.1.1",
		"knip": "6.16.1",
		"prettier": "3.8.4",
		"prettier-plugin-organize-imports": "4.3.0",
		"stylelint": "17.13.0"
	},
	"files": [
		"dist",
		"public",
		"src",
		"index.html",
		"tsconfig.json",
		"unocss.config.ts",
		"vite.config.ts"
	],
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	}
}
