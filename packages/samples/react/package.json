		"@stencil/core": "4.38.3",
		"@types/node": "26.4.0",
		"@types/papaparse": "5.5.2",
		"papaparse": "5.7.0",
		"react-hook-form": "7.86.0",
		"react-number-format": "5.4.5",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"world_countries_lists": "3.3.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"adopted-style-sheets": "1.1.9-rc.25",
		"eslint": "9.39.5",
		"knip": "6.32.3",
