{
	"name": "@public-ui/presentation",
	"version": "4.0.2",
	"description": "This package contains presentation samples for the KoliBri/Public UI",
	"license": "EUPL-1.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"scripts": {
		"build": "vite build",
		"build:deps": "pnpm --filter @public-ui/presentation^... build",
		"format": "prettier --check src",
		"lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:tsc",
		"lint:eslint": "eslint src",
		"lint:stylelint": "stylelint \"src/**/*.{css,scss}\"",
		"lint:tsc": "tsc --noemit",
		"prepare": "npm-run-all2 prepare:*",
		"prepare:components": "cpy \"node_modules/@public-ui/components/assets/**/*\" public/assets --dot",
		"prepare:themes": "cpy \"node_modules/@public-ui/themes/assets/**/*\" public/assets --dot",
		"serve": "vite",
		"start": "vite --open",
		"unused": "knip"
	},
	"dependencies": {
		"@leanup/stack": "1.3.54",
		"@public-ui/sample-react": "workspace:*",
		"@public-ui/themes": "workspace:*",
		"adopted-style-sheets": "1.1.9-rc.20",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-router-dom": "7.12.0",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@types/node": "24.10.9",
		"@types/react": "19.2.9",
		"@types/react-dom": "19.2.3",
		"@typescript-eslint/eslint-plugin": "8.53.1",
		"@typescript-eslint/parser": "8.53.1",
		"@unocss/preset-mini": "66.5.10",
		"@unocss/vite": "66.5.10",
		"@vitejs/plugin-react-swc": "4.2.2",
		"cpy-cli": "6.0.0",
		"eslint": "8.57.1",
		"eslint-plugin-html": "8.1.3",
		"eslint-plugin-json": "3.1.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react": "7.37.5",
		"knip": "5.82.1",
		"npm-run-all2": "8.0.4",
		"prettier": "3.8.1",
		"prettier-plugin-organize-imports": "4.3.0",
		"stylelint": "16.26.1",
		"typescript": "5.9.3",
		"vite": "7.3.1"
	},
	"files": [
		"dist",
		"public",
		"src",
		"index.html",
		"tsconfig.json",
		"unocss.config.ts",
		"vite.config.ts"
	]
}
