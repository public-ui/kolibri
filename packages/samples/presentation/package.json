{
	"name": "@public-ui/presentation",
	"version": "4.3.0-rc.1",
	"description": "This package contains presentation samples for the KoliBri/Public UI",
	"license": "EUPL-1.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"scripts": {
		"build": "vite build",
		"build:deps": "pnpm --filter @public-ui/presentation^... build",
		"format": "prettier --check src",
		"lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:tsc",
		"lint:eslint": "eslint src",
		"lint:stylelint": "stylelint \"src/**/*.{css,scss}\"",
		"lint:tsc": "tsc --noemit",
		"prebuild": "kolibri-copy-assets --dest public/assets @public-ui/components @public-ui/themes",
		"prepare": "pnpm prebuild",
		"serve": "vite",
		"start": "vite --open",
		"unused": "knip"
	},
	"dependencies": {
		"@public-ui/components": "workspace:*",
		"@public-ui/react-v19": "workspace:*",
		"@public-ui/sample-react": "workspace:*",
		"@public-ui/themes": "workspace:*",
		"adopted-style-sheets": "1.1.9-rc.25",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-router-dom": "7.18.0"
	},
	"devDependencies": {
		"@public-ui/eslint-config": "workspace:*",
		"@types/node": "25.9.4",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@unocss/preset-mini": "66.7.2",
		"@unocss/vite": "66.7.2",
		"@vitejs/plugin-react-swc": "4.3.1",
		"eslint": "9.39.4",
		"knip": "6.18.0",
		"prettier": "3.8.4",
		"prettier-plugin-organize-imports": "4.3.0",
		"stylelint": "17.13.0",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"vite": "8.0.16"
	},
	"files": [
		"dist",
		"public",
		"src",
		"index.html",
		"tsconfig.json",
		"unocss.config.ts",
		"vite.config.ts"
	]
}
