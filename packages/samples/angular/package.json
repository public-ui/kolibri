{
	"name": "@public-ui/sample-angular",
	"private": true,
	"scripts": {
		"build": "ng build",
		"build:deps": "pnpm --filter @public-ui/sample-angular^... build",
		"format": "prettier --check src",
		"prebuild": "kolibri-copy-assets --dest src/assets @public-ui/components @public-ui/theme-default",
		"prepare": "pnpm prebuild",
		"start": "ng serve",
		"unused": "knip"
	},
	"dependencies": {
		"@angular/animations": "21.2.19",
		"@angular/common": "20.3.27",
		"@angular/compiler": "20.3.27",
		"@angular/core": "20.3.25",
		"@angular/platform-browser": "21.2.19",
		"@angular/router": "21.2.19",
		"@public-ui/angular-v21": "workspace:*",
		"@public-ui/components": "workspace:*",
		"@public-ui/theme-default": "workspace:*",
		"rxjs": "7.8.2",
		"tslib": "2.8.1",
		"zone.js": "0.16.2"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "21.2.20",
		"@angular/cli": "21.2.20",
		"@angular/compiler-cli": "21.2.19",
		"@types/jasmine": "6.0.0",
		"@tailwindcss/postcss": "4.3.3",
		"adopted-style-sheets": "1.1.9-rc.25",
		"hono": "4.13.1",
		"karma-jasmine": "5.1.0",
		"karma-chrome-launcher": "3.2.0",
		"karma-jasmine-html-reporter": "2.2.0",
		"karma-coverage": "2.2.1",
		"jasmine-core": "6.3.0",
		"knip": "6.32.1",
		"postcss": "8.5.26",
		"prettier": "3.9.6",
		"prettier-plugin-organize-imports": "4.3.0",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3"
	}
}
