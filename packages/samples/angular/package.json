{
	"name": "@public-ui/sample-angular",
	"version": "3.0.0-rc.13",
	"private": true,
	"scripts": {
		"build": "ng build",
		"build:deps": "pnpm --filter @public-ui/sample-angular^... build",
		"format": "prettier --check src",
		"prepare": "pnpm prepare:components && pnpm prepare:theme-default",
		"prepare:components": "cpy \"node_modules/@public-ui/components/assets/**/*\" src/assets --dot",
		"prepare:theme-default": "cpy \"node_modules/@public-ui/theme-default/assets/**/*\" src/assets --dot",
		"start": "ng serve",
		"unused": "knip"
	},
	"dependencies": {
		"@angular/animations": "21.2.12",
		"@angular/common": "21.2.12",
		"@angular/compiler": "21.2.12",
		"@angular/core": "21.2.12",
		"@angular/platform-browser": "21.2.12",
		"@angular/router": "21.2.12",
		"@public-ui/angular-v21": "workspace:*",
		"@public-ui/components": "workspace:*",
		"@public-ui/themes": "workspace:*",
		"rxjs": "7.8.2",
		"tslib": "2.8.1",
		"zone.js": "0.16.2"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "21.2.10",
		"@angular/cli": "21.2.10",
		"@angular/compiler-cli": "21.2.12",
		"@types/jasmine": "5.1.15",
		"@tailwindcss/postcss": "4.3.0",
		"adopted-style-sheets": "1.1.9-rc.22",
		"cpy-cli": "6.0.0",
		"karma-jasmine": "5.1.0",
		"karma-chrome-launcher": "3.2.0",
		"karma-jasmine-html-reporter": "2.2.0",
		"karma-coverage": "2.2.1",
		"jasmine-core": "5.13.0",
		"knip": "5.88.1",
		"postcss": "8.5.14",
		"prettier": "3.8.3",
		"prettier-plugin-organize-imports": "4.3.0",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3"
	}
}
