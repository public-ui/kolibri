{
	"name": "@public-ui/sample-angular",
	"private": true,
	"scripts": {
		"build": "ng build",
		"build:deps": "pnpm --filter @public-ui/sample-angular^... build",
		"format": "prettier --check src",
		"prebuild": "npm-run-all2 prebuild:*",
		"prebuild:components": "cpy \"node_modules/@public-ui/components/assets/**/*\" src/assets --dot",
		"prebuild:themes": "cpy \"node_modules/@public-ui/themes/assets/**/*\" src/assets --dot",
		"prepare": "pnpm prebuild",
		"start": "ng serve",
		"unused": "knip"
	},
	"dependencies": {
		"@angular/animations": "22.0.0",
		"@angular/common": "22.0.0",
		"@angular/compiler": "22.0.0",
		"@angular/core": "22.0.0",
		"@angular/platform-browser": "22.0.0",
		"@angular/router": "22.0.0",
		"@public-ui/angular-v22": "workspace:*",
		"@public-ui/components": "workspace:*",
		"@public-ui/themes": "workspace:*",
		"rxjs": "7.8.2",
		"tslib": "2.8.1",
		"zone.js": "0.16.2"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "22.0.0",
		"@angular/cli": "22.0.0",
		"@angular/compiler-cli": "22.0.0",
		"@types/jasmine": "6.0.0",
		"@tailwindcss/postcss": "4.3.0",
		"adopted-style-sheets": "1.1.9-rc.22",
		"cpy-cli": "7.0.0",
		"hono": "4.12.23",
		"karma-jasmine": "5.1.0",
		"karma-chrome-launcher": "3.2.0",
		"karma-jasmine-html-reporter": "2.2.0",
		"karma-coverage": "2.2.1",
		"jasmine-core": "6.2.0",
		"knip": "6.15.0",
		"npm-run-all2": "8.0.4",
		"postcss": "8.5.15",
		"prettier": "3.8.3",
		"prettier-plugin-organize-imports": "4.3.0",
		"tailwindcss": "3.4.19",
		"typescript": "6.0.3"
	}
}
