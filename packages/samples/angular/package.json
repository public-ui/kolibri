{
	"name": "@public-ui/sample-angular",
	"version": "3.0.0-rc.13",
	"private": true,
	"scripts": {
		"build": "ng build",
		"build:deps": "pnpm --filter @public-ui/sample-angular^... build",
		"format": "prettier --check src",
		"prepare": "cpy \"node_modules/@public-ui/components/assets/**/*\" src/assets --dot",
		"start": "ng serve",
		"unused": "knip"
	},
	"dependencies": {
		"@angular/animations": "20.3.5",
		"@angular/common": "20.3.5",
		"@angular/compiler": "20.3.5",
		"@angular/core": "20.3.5",
		"@angular/platform-browser": "20.3.5",
		"@angular/router": "20.3.5",
		"@public-ui/angular-v20": "workspace:*",
		"@public-ui/components": "workspace:*",
		"@public-ui/themes": "workspace:*",
		"rxjs": "7.8.2",
		"tslib": "2.8.1",
		"zone.js": "0.15.1"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "20.3.6",
		"@angular/cli": "20.3.6",
		"@angular/compiler-cli": "20.3.5",
		"@types/jasmine": "5.1.10",
		"@tailwindcss/postcss": "4.1.14",
		"adopted-style-sheets": "1.1.9-rc.20",
		"cpy-cli": "6.0.0",
		"karma-jasmine": "5.1.0",
		"karma-chrome-launcher": "3.2.0",
		"karma-jasmine-html-reporter": "2.1.0",
		"karma-coverage": "2.2.1",
		"jasmine-core": "5.12.0",
		"knip": "5.65.0",
		"postcss": "8.5.6",
		"prettier": "3.6.2",
		"tailwindcss": "3.4.18",
		"typescript": "5.9.3"
	}
}
