{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"lib": ["ES2020"],
		"moduleResolution": "node",
		"outDir": "dist",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node", "vscode"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
