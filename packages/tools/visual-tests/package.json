{
	"name": "@public-ui/visual-tests",
	"version": "4.3.0-rc.8",
	"license": "EUPL-1.2",
	"homepage": "https://public-ui.github.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"bugs": {
		"url": "https://github.com/public-ui/kolibri/issues",
		"email": "kolibri@itzbund.de"
	},
	"author": {
		"name": "Informationstechnikzentrum Bund",
		"email": "kolibri@itzbund.de"
	},
	"engines": {
		"pnpm": "^10"
	},
	"type": "module",
	"description": "Provides utility to run visual regression tests for themes.",
	"scripts": {
		"build": "vite build --config app/vite.config.ts",
		"build:deps": "pnpm --filter @public-ui/visual-tests^... build",
		"prebuild": "npm-run-all2 prebuild:*",
		"prebuild:components": "kolibri-copy-assets --dest app/public/assets @public-ui/components @public-ui/sample-react",
		"format": "prettier --check src app/src",
		"lint": "pnpm lint:eslint",
		"lint:eslint": "eslint src",
		"serve": "vite --config app/vite.config.ts",
		"unused": "knip"
	},
	"bin": {
		"kolibri-visual-test": "src/index.js"
	},
	"dependencies": {
		"@axe-core/playwright": "4.12.1",
		"@public-ui/components": "workspace:*",
		"@public-ui/react-v19": "workspace:*",
		"@public-ui/sample-react": "workspace:*",
		"@unocss/preset-mini": "66.7.5",
		"@unocss/vite": "66.7.5",
		"@vitejs/plugin-react-swc": "4.3.2",
		"adopted-style-sheets": "1.1.9-rc.25",
		"axe-html-reporter": "2.2.11",
		"http-server": "14.1.1",
		"npm-run-all2": "9.0.3",
		"portfinder": "1.0.38",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router": "8.3.0",
		"vite": "8.1.5"
	},
	"devDependencies": {
		"@public-ui/eslint-config": "workspace:*",
		"@types/node": "26.1.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"eslint": "9.39.5",
		"knip": "6.29.0",
		"prettier": "3.9.6",
		"prettier-plugin-organize-imports": "4.3.0",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"@playwright/test": "1.60.0"
	},
	"files": [
		"app",
		"playwright.config.js",
		"src",
		"tests"
	]
}
