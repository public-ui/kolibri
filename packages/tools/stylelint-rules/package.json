{
	"name": "@public-ui/stylelint-rules",
	"version": "4.7.0-rc.1",
	"license": "EUPL-1.2",
	"homepage": "https://public-ui.github.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri",
		"directory": "packages/tools/stylelint-rules"
	},
	"bugs": {
		"url": "https://github.com/public-ui/kolibri/issues",
		"email": "kolibri@itzbund.de"
	},
	"author": {
		"name": "Informationstechnikzentrum Bund",
		"email": "kolibri@itzbund.de"
	},
	"description": "Custom Stylelint rules for the KoliBri component library and their themes.",
	"keywords": [
		"kolibri",
		"scss",
		"stylelint",
		"stylelint-plugin",
		"web-components"
	],
	"type": "module",
	"exports": {
		".": "./src/index.js"
	},
	"files": [
		"src",
		"!src/**/*.test.js"
	],
	"scripts": {
		"format": "prettier --check src",
		"lint": "pnpm lint:eslint",
		"lint:eslint": "eslint src",
		"test": "mocha \"src/**/*.test.js\"",
		"test:unit": "mocha \"src/**/*.test.js\"",
		"unused": "knip"
	},
	"devDependencies": {
		"@public-ui/eslint-config": "workspace:*",
		"eslint": "9.39.5",
		"knip": "6.42.1",
		"mocha": "11.8.0",
		"postcss-scss": "4.0.9",
		"prettier": "3.9.10",
		"prettier-plugin-organize-imports": "4.3.0",
		"stylelint": "17.16.0"
	},
	"peerDependencies": {
		"stylelint": ">=17"
	}
}
