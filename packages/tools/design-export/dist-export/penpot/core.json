{
	"border": {
		"radius": {
			"$type": "dimension",
			"$value": "5px"
		},
		"width": {
			"$type": "dimension",
			"$value": "1px"
		}
	},
	"inner": {
		"border-radius": {
			"$type": "dimension",
			"$value": "4px"
		}
	},
	"font": {
		"family": {
			"$type": "other",
			"$value": "Verdana, Arial, Calibri, Helvetica, sans-serif"
		},
		"size": {
			"$type": "other",
			"$value": "calc(16 * 1rem / var(--kolibri-root-font-size, 16))"
		}
	},
	"spacing": {
		"$type": "other",
		"$value": "calc(4 * 1rem / var(--kolibri-root-font-size, 16))"
	},
	"color": {
		"shadow": {
			"$type": "color",
			"$value": "light-dark(rgb(8, 35, 48, 0.24), transparent)"
		},
		"shadow-inverse": {
			"$type": "color",
			"$value": "light-dark(rgb(255, 255, 255, 0.24), transparent)"
		},
		"shadow-contrast": {
			"$type": "color",
			"$value": "light-dark(color-mix(in srgb, black 80%, var(--color-subtle)), transparent)"
		},
		"backdrop": {
			"$type": "color",
			"$value": "light-dark(transparent, rgb(0, 0, 0, 0.55))"
		}
	},
	"fa": {
		"animation-direction": {
			"$type": "other",
			"$value": "reverse"
		},
		"font-brands": {
			"$type": "other",
			"$value": "normal 400 1em/1 'Font Awesome 6 Brands'"
		},
		"font-regular": {
			"$type": "other",
			"$value": "normal 400 1em/1 'Font Awesome 6 Free'"
		},
		"font-solid": {
			"$type": "other",
			"$value": "normal 900 1em/1 'Font Awesome 6 Free'"
		}
	}
}
