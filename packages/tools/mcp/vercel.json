{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"version": 2,
	"buildCommand": "echo 'Skipping build - using pre-built artifacts'",
	"installCommand": "echo 'Skipping install - using pre-built artifacts'",
	"rewrites": [
		{
			"source": "/mcp",
			"destination": "/api/mcp"
		},
		{
			"source": "/mcp/(.*)",
			"destination": "/api/mcp"
		},
		{
			"source": "/http",
			"destination": "/api/mcp"
		},
		{
			"source": "/http/(.*)",
			"destination": "/api/mcp"
		},
		{
			"source": "/sse",
			"destination": "/api/mcp"
		},
		{
			"source": "/sse/(.*)",
			"destination": "/api/mcp"
		}
	]
}
