		"content": "// ============================================================================\n// KONSTANTEN\n// ============================================================================\n\nexport const BEREICHE = [\n\t{ label: 'Arbeit (z.B. Jobsuche, Sozialleistungen)', value: 'arbeit' },\n\t{ label: 'Behördenprozesse (z.B. Anträge, Bescheide)', value: 'behoerdenprozesse' },\n\t{ label: 'Bildung (z.B. Schule, Wissenschaft)', value: 'bildung' },\n\t{ label: 'Digitalisierung (z.B. neue Techniken)', value: 'digitalisierung' },\n\t{ label: 'Energie (z.B. Strom, Gas, Wasser)', value: 'energie' },\n\t{ label: 'Familie (z.B. Jugendamt, Betreuung)', value: 'familie' },\n\t{ label: 'Förderprogramme (z.B. Förderanträge)', value: 'foerderprogramme' },\n\t{ label: 'Gesundheit (z.B. Arzt, Krankenkasse)', value: 'gesundheit' },\n\t{ label: 'Infrastruktur (z.B. Bauantrag, Umbau)', value: 'infrastruktur' },\n\t{ label: 'Interne Verwaltung (z.B. Vorgaben)', value: 'interne_verwaltung' },\n\t{ label: 'Landwirtschaft (z.B. Agrarsubvention)', value: 'landwirtschaft' },\n\t{ label: 'Migration (z.B. Einwanderung)', value: 'migration' },\n\t{ label: 'Mobilität (z.B. ÖPNV, Auto)', value: 'mobilitaet' },\n\t{ label: 'Sicherheit (z.B. Polizei, Gesetze)', value: 'sicherheit' },\n\t{ label: 'Steuern (z.B. Steuererklärung)', value: 'steuern' },\n\t{ label: 'Umwelt(schutz) (z.B. Recycling)', value: 'umwelt' },\n\t{ label: 'Vereinswesen (z.B. Vereinsgründung)', value: 'vereinswesen' },\n\t{ label: 'Wirtschaft (z.B. Selbstständigkeit)', value: 'wirtschaft' },\n];\n\nexport const AUFWANDS_ARTEN = [\n\t{ label: 'Beiträge / Gebühren / Steuern', value: 'beitraege' },\n\t{ label: 'Berichte / Dokumentationen / Nachweise', value: 'berichte' },\n\t{ label: 'Form / mehrfache Dateneingabe / Zuständigkeiten', value: 'form' },\n\t{ label: 'Genehmigungen / Registrierungen / Zulassungen', value: 'genehmigungen' },\n\t{ label: 'IT- und Datenschutz / Emission / Umweltsicherheit', value: 'it_datenschutz' },\n\t{ label: 'Sonstiges', value: 'sonstiges' },\n];\n\nexport const NUTZNIESSER = [\n\t{ label: 'Privatperson', value: 'privatperson' },\n\t{ label: 'Unternehmen / Selbstständige', value: 'unternehmen' },\n\t{ label: 'Verwaltungsmitarbeitende', value: 'verwaltung' },\n\t{ label: 'Verbände / Zivilgesellschaft', value: 'verbaende' },\n\t{ label: 'Sonstige / keine Angabe', value: 'sonstige' },\n];\n\nexport const TOTAL_STEPS = 7;\n",
