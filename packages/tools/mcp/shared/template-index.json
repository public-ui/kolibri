		"content": "/* ============================================================================\n   Bürokratiehürden-Formular - KoliBri Styling\n   ============================================================================ */\n\n@import url('https://fonts.googleapis.com/css2?family=BundesSans+Web:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap');\n\n:root {\n\t/* Hauptfarben aus dem Original-Design */\n\t--primary-bg: #4338ca;\n\t--primary-dark: #3730a3;\n\t--accent-teal: #2dd4bf;\n\t--accent-mint: #34d399;\n\t--text-light: #e0e7ff;\n\t--text-white: #ffffff;\n\t--text-muted: #c7d2fe;\n\t--button-bg: #1e1b4b;\n\t--button-hover: #312e81;\n\t--card-bg: rgba(255, 255, 255, 0.95);\n\t--card-text: #1e1b4b;\n\t--error-color: #f87171;\n\t--success-color: #34d399;\n\t--light-bg: #e0e7ff;\n\n\t/* KoliBri-Komponenten Hintergrund */\n\t--kolibri-bg: transparent;\n}\n\n* {\n\tbox-sizing: border-box;\n\tmargin: 0;\n\tpadding: 0;\n}\n\nhtml,\nbody {\n\tfont-family: 'BundesSans Web', 'Inter', system-ui, sans-serif;\n\tbackground: linear-gradient(135deg, var(--primary-bg) 0%, var(--primary-dark) 100%);\n\tmin-height: 100vh;\n\tcolor: var(--text-white);\n\tline-height: 1.6;\n}\n\n#root {\n\tmin-height: 100vh;\n}\n\n/* ============================================================================\n   APP CONTAINER\n   ============================================================================ */\n\n.app {\n\tmax-width: 900px;\n\tmargin: 0 auto;\n\tpadding: 2rem;\n\tmin-height: 100vh;\n\tdisplay: flex;\n\tflex-direction: column;\n}\n\n.app-light {\n\tbackground: var(--light-bg);\n}\n\n.form-container {\n\tdisplay: flex;\n\tflex-direction: column;\n\tmargin: 0 1rem;\n\tbackground: white;\n\tborder-radius: 12px;\n\tbox-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n\tpadding: 1.5rem;\n}\n\n/* ============================================================================\n   STARTSEITE\n   ============================================================================ */\n\n.start-page {\n\tdisplay: flex;\n\tflex-direction: column;\n\tjustify-content: center;\n\talign-items: flex-start;\n\tmin-height: 80vh;\n\tpadding: 4rem;\n\tbackground: var(--accent-mint);\n\tmargin: -2rem;\n\tborder-radius: 0;\n}\n\n.hero-text {\n\tfont-size: clamp(6rem, 22vw, 16rem);\n\tfont-weight: 700;\n\tcolor: var(--primary-bg);\n\tline-height: 0.85;\n\tletter-spacing: -0.05em;\n\tmargin-bottom: 2rem;\n}\n\n.intro-text {\n\tfont-size: 1.5rem;\n\tcolor: var(--primary-dark);\n\tmax-width: 700px;\n\tmargin-bottom: 1.5rem;\n\tline-height: 1.4;\n}\n\n.slogan {\n\tfont-size: 1.25rem;\n\tcolor: var(--primary-bg);\n\tfont-weight: 600;\n\tmargin-bottom: 2rem;\n}\n\n/* ============================================================================\n   ERFOLGSSEITE\n   ============================================================================ */\n\n.success-page {\n\tdisplay: flex;\n\tflex-direction: column;\n\tjustify-content: center;\n\talign-items: flex-start;\n\tmin-height: 80vh;\n\tpadding: 2rem 0;\n}\n\n.yeah-text {\n\tfont-size: clamp(5rem, 18vw, 12rem);\n\tfont-weight: 700;\n\tcolor: var(--primary-bg);\n\tline-height: 0.9;\n\tletter-spacing: -0.03em;\n\tmargin-bottom: 1.5rem;\n}\n\n.danke-text {\n\tfont-size: 2.5rem;\n\tfont-weight: 400;\n\tcolor: var(--accent-teal);\n\tmargin-bottom: 1rem;\n}\n\n.success-message {\n\tfont-size: 1.25rem;\n\tcolor: var(--primary-bg);\n\tmargin-bottom: 0.5rem;\n}\n\n.success-slogan {\n\tfont-size: 1.1rem;\n\tcolor: #6366f1;\n\tfont-style: italic;\n\tmargin-bottom: 2rem;\n}\n\n/* ============================================================================\n   SCHRITTANZEIGE\n   ============================================================================ */\n\n.step-indicator {\n\tmargin-bottom: 2rem;\n\tpadding: 1rem 0;\n}\n\n.step-indicator ul {\n\tdisplay: flex;\n\tgap: 0.75rem;\n\tlist-style: none;\n\tmargin: 0;\n\tpadding: 0;\n}\n\n.step-number {\n\tfont-size: 1rem;\n\tfont-weight: 500;\n\tcolor: var(--text-muted);\n\ttransition: all 0.3s ease;\n}\n\n.step-number.active {\n\tfont-size: 1.75rem;\n\tfont-weight: 700;\n\tcolor: var(--text-white);\n}\n\n.step-number.completed {\n\tcolor: #a5b4fc;\n}\n\n/* ============================================================================\n   FORMULAR-SCHRITTE\n   ============================================================================ */\n\n.step-content {\n\tflex: 1;\n\tanimation: fadeIn 0.3s ease-out;\n}\n\n.step-wrapper {\n\tflex: 1;\n}\n\n@keyframes fadeIn {\n\tfrom {\n\t\topacity: 0;\n\t\ttransform: translateY(10px);\n\t}\n\tto {\n\t\topacity: 1;\n\t\ttransform: translateY(0);\n\t}\n}\n\n/* Überschriften */\n.heading-text {\n\tcolor: var(--primary-bg);\n\tfont-size: 1.75rem;\n\tfont-weight: 400;\n\tline-height: 1.3;\n}\n\n.heading-text strong {\n\tfont-weight: 700;\n}\n\n.step-content kol-heading {\n\tmargin-bottom: 1.5rem;\n}\n\n.subtitle {\n\tcolor: #4b5563;\n\tmargin-bottom: 1.5rem;\n\tfont-size: 0.95rem;\n}\n\n/* ============================================================================\n   FORMULARFELDER\n   ============================================================================ */\n\n.form-field {\n\tmargin-bottom: 1.5rem;\n}\n\n/* KolDetails Styling */\nkol-details {\n\tmargin-top: 1rem;\n}\n\nkol-details::part(summary) {\n\tcolor: var(--primary-bg);\n\tfont-weight: 600;\n}\n\nkol-details::part(content) {\n\tpadding: 1rem 0;\n}\n\nkol-details p {\n\tfont-size: 0.9rem;\n\tline-height: 1.5;\n\tcolor: #4b5563;\n\tmargin: 0;\n}\n\n/* Checkbox Liste */\n.checkbox-list {\n\tdisplay: flex;\n\tflex-direction: column;\n\tgap: 0.5rem;\n}\n\n.checkbox-item {\n\tpadding: 0.5rem 0;\n}\n\n/* ============================================================================\n   CAPTCHA\n   ============================================================================ */\n\n.captcha-section {\n\tmargin-top: 2rem;\n}\n\n.captcha-label {\n\tdisplay: block;\n\tcolor: var(--text-light);\n\tmargin-bottom: 1rem;\n\tfont-size: 1rem;\n}\n\n.captcha-row {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 0.75rem;\n\tmargin-bottom: 0.75rem;\n}\n\n.captcha-image-wrapper {\n\tbackground: #e8f5e9;\n\tpadding: 0.5rem 1rem;\n\tborder-radius: 4px;\n}\n\n.captcha-image {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n}\n\n.captcha-text {\n\tfont-family: 'Times New Roman', serif;\n\tfont-size: 1.75rem;\n\tfont-weight: bold;\n\tcolor: #2e7d32;\n\tletter-spacing: 0.1em;\n\tfont-style: italic;\n\ttext-decoration: line-through;\n\ttext-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);\n}\n\n.captcha-button {\n\twidth: 40px;\n\theight: 40px;\n\tbackground: transparent;\n\tborder: none;\n\tcolor: var(--text-white);\n\tfont-size: 1.5rem;\n\tcursor: pointer;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\ttransition: opacity 0.2s;\n}\n\n.captcha-button:hover {\n\topacity: 0.7;\n}\n\n/* ============================================================================\n   BUTTONS\n   ============================================================================ */\n\n.error-list {\n\tmargin-top: 1.5rem;\n}\n\n.error-list ul {\n\tmargin: 0.5rem 0 0 0;\n\tpadding-left: 1.5rem;\n}\n\n.error-list li {\n\tmargin: 0.25rem 0;\n}\n\n.button-row {\n\tdisplay: flex;\n\tflex-direction: row-reverse;\n\tgap: 1rem;\n\tmargin-top: 2rem;\n\tpadding-top: 1.5rem;\n\tborder-top: 2px solid #e5e7eb;\n\tposition: sticky;\n\tbottom: 0;\n\tbackground: white;\n\tmargin-left: -1.5rem;\n\tmargin-right: -1.5rem;\n\tmargin-bottom: -1.5rem;\n\tpadding: 1.5rem;\n\tborder-bottom-left-radius: 12px;\n\tborder-bottom-right-radius: 12px;\n}\n\n.button-row kol-button {\n\tflex: 1;\n}\n\n/* ============================================================================\n   KoliBri COMPONENT OVERRIDES\n   ============================================================================ */\n\n/* Alle KoliBri-Komponenten transparent */\nkol-button,\nkol-input-text,\nkol-textarea,\nkol-input-radio,\nkol-input-checkbox,\nkol-heading,\nkol-alert,\nkol-icon {\n\tbackground: transparent !important;\n}\n\n/* Button Styling */\nkol-button::part(button) {\n\tpadding: 1rem 2rem;\n\tfont-size: 1rem;\n\tfont-weight: 500;\n\tborder-radius: 4px;\n\twidth: 100%;\n}\n\n/* Startseite Button */\n.start-page kol-button::part(button) {\n\tbackground: var(--kolibri-bg);\n\tcolor: var(--text-white);\n\tpadding: 1rem 3rem;\n\twidth: auto;\n}\n\n/* Erfolgsseite Button */\n.success-page kol-button::part(button) {\n\tbackground: var(--kolibri-bg);\n\tcolor: var(--primary-bg);\n\tborder: 2px solid var(--primary-bg);\n}\n\n/* Primary Button */\nkol-button[_variant='primary']::part(button) {\n\tbackground: var(--kolibri-bg);\n\tcolor: var(--primary-dark);\n\tborder: none;\n}\n\n/* Secondary Button */\nkol-button[_variant='secondary']::part(button) {\n\tbackground: var(--kolibri-bg);\n\tcolor: var(--text-white);\n\tborder: none;\n}\n\n/* Ghost/Disabled Button */\nkol-button[_variant='ghost']::part(button),\nkol-button[_disabled]::part(button) {\n\tbackground: var(--kolibri-bg);\n\tcolor: #6b7280;\n\tborder: 2px solid #6b7280;\n\topacity: 0.6;\n\tcursor: not-allowed;\n}\n\n/* Input/Textarea Styling */\nkol-input-text::part(input) {\n\tpadding: 1rem;\n\tfont-size: 1rem;\n\tborder-radius: 8px;\n\tborder: 2px solid transparent;\n\tbackground: var(--kolibri-bg);\n\tcolor: var(--card-text);\n}\n\nkol-textarea::part(textarea):focus,\nkol-input-text::part(input):focus {\n\tborder-color: var(--accent-teal);\n\toutline: none;\n}\n\n/* Radio/Checkbox Labels */\nkol-input-radio::part(label),\nkol-input-checkbox::part(label) {\n\tcolor: var(--card-text);\n\tfont-size: 1rem;\n}\n\n/* Radio Buttons */\nkol-input-radio::part(input) {\n\taccent-color: var(--accent-teal);\n\twidth: 22px;\n\theight: 22px;\n}\n\n/* Checkboxes */\nkol-input-checkbox::part(input) {\n\taccent-color: var(--accent-teal);\n\twidth: 22px;\n\theight: 22px;\n}\n\n/* Heading */\nkol-heading::part(heading) {\n\tcolor: var(--primary-bg);\n}\n\n/* Alert/Error Messages */\nkol-alert[_type='error'] {\n\tmargin-top: 0.5rem;\n}\n\n/* ============================================================================\n   RESPONSIVE\n   ============================================================================ */\n\n@media (max-width: 768px) {\n\t.app {\n\t\tpadding: 1rem;\n\t}\n\n\t.start-page {\n\t\tmargin: -1rem;\n\t\tpadding: 2rem;\n\t}\n\n\t.hero-text {\n\t\tfont-size: 5rem;\n\t}\n\n\t.yeah-text {\n\t\tfont-size: 4rem;\n\t}\n\n\t.intro-text {\n\t\tfont-size: 1.25rem;\n\t}\n\n\t.heading-text {\n\t\tfont-size: 1.5rem;\n\t}\n\n\t.button-row {\n\t\tflex-direction: column-reverse;\n\t\tposition: sticky;\n\t\tbottom: 0;\n\t\tmargin-left: -1.5rem;\n\t\tmargin-right: -1.5rem;\n\t\tmargin-bottom: -1.5rem;\n\t\tpadding: 1.5rem;\n\t\tbox-shadow: 0 -4px 6px rgba(0, 0, 0, 0.1);\n\t}\n\n\t.captcha-row {\n\t\tflex-wrap: wrap;\n\t}\n\n\t.step-indicator {\n\t\tflex-wrap: wrap;\n\t\tgap: 0.5rem;\n\t}\n}\n\n/* ============================================================================\n   PRINT STYLES\n   ============================================================================ */\n\n@media print {\n\t.button-row,\n\t.step-indicator {\n\t\tdisplay: none;\n\t}\n\n\t.app {\n\t\tbackground: white;\n\t\tcolor: black;\n\t}\n}\n",
