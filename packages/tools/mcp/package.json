{
	"name": "@public-ui/mcp",
	"version": "4.0.0-alpha.2",
	"license": "EUPL-1.2",
	"homepage": "https://public-ui.github.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"bugs": {
		"url": "https://github.com/public-ui/kolibri/issues",
		"email": "kolibri@itzbund.de"
	},
	"author": {
		"name": "Informationstechnikzentrum Bund",
		"email": "kolibri@itzbund.de"
	},
	"type": "module",
	"private": false,
	"description": "Model Context Protocol server providing AI agents access to 136+ KoliBri component examples and source code.",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"kolibri",
		"design-system",
		"ai-agent",
		"component-library",
		"accessibility",
		"react",
		"typescript"
	],
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"bin": {
		"kolibri-mcp": "dist/cli.cjs"
	},
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build:deps": "pnpm --filter @public-ui/mcp^... build",
		"generate-index": "node ./scripts/generate-sample-index.mjs",
		"prebuild": "pnpm generate-index",
		"build": "unbuild",
		"predev": "pnpm generate-index",
		"dev": "nodemon",
		"format": "prettier --check src",
		"inspect": "mcp-inspector tsx src/mcp.ts",
		"prestart": "pnpm build",
		"start": "node dist/mcp.cjs",
		"start:stdio": "node dist/cli.cjs",
		"pretest": "pnpm build",
		"test": "node --test test/*.test.js",
		"test:api": "node test-vercel-api.mjs",
		"vercel:dev": "vercel dev",
		"vercel:deploy": "vercel",
		"vercel:deploy:prod": "vercel --prod"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.21.0",
		"@public-ui/components": "workspace:*",
		"express": "5.1.0",
		"fuse.js": "7.1.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@modelcontextprotocol/inspector": "0.17.2",
		"@types/express": "5.0.5",
		"@types/node": "24.10.0",
		"nodemon": "3.1.10",
		"prettier": "3.6.2",
		"prettier-plugin-organize-imports": "4.3.0",
		"tsx": "4.20.6",
		"typescript": "5.9.3",
		"unbuild": "3.6.1"
	},
	"files": [
		"dist/",
		"README.md"
	]
}
