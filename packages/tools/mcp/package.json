{
	"name": "@public-ui/mcp",
	"version": "4.3.0-rc.7",
	"license": "EUPL-1.2",
	"homepage": "https://public-ui.github.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"bugs": {
		"url": "https://github.com/public-ui/kolibri/issues",
		"email": "kolibri@itzbund.de"
	},
	"author": {
		"name": "Informationstechnikzentrum Bund",
		"email": "kolibri@itzbund.de"
	},
	"type": "module",
	"private": false,
	"description": "Model Context Protocol server providing AI agents access to 136+ KoliBri component examples, source code, and template repositories.",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"kolibri",
		"design-system",
		"ai-agent",
		"component-library",
		"accessibility",
		"react",
		"typescript"
	],
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"bin": {
		"@public-ui/mcp": "dist/cli.cjs",
		"kolibri-mcp": "dist/cli.cjs"
	},
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build:deps": "pnpm --filter @public-ui/mcp^... build",
		"generate-index": "node ./scripts/generate-sample-index.mjs",
		"generate-templates-index": "tsx ./scripts/generate-templates-index.mjs",
		"prebuild": "pnpm generate-index && pnpm generate-templates-index",
		"build": "unbuild",
		"predev": "pnpm generate-index && pnpm generate-templates-index",
		"dev": "nodemon",
		"format": "prettier -c src test public",
		"lint": "pnpm lint:eslint && pnpm lint:tsc",
		"lint:eslint": "eslint src test",
		"lint:tsc": "tsc --noemit",
		"preinspect": "pnpm generate-index",
		"inspect": "mcp-inspector tsx src/cli.ts",
		"prestart": "pnpm build",
		"start": "node dist/mcp.cjs",
		"start:stdio": "node dist/cli.cjs",
		"pretest": "pnpm build",
		"test": "node --test test/*.test.js",
		"test:api": "node test-vercel-api.mjs",
		"unused": "knip",
		"vercel:dev": "vercel dev",
		"vercel:deploy": "vercel",
		"vercel:deploy:prod": "vercel --prod"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.30.0",
		"@public-ui/components": "workspace:*",
		"express": "5.2.1",
		"fuse.js": "7.5.0",
		"glob": "13.0.6",
		"simple-git": "3.36.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@modelcontextprotocol/inspector": "2.0.0",
		"@public-ui/eslint-config": "workspace:*",
		"@types/express": "5.0.6",
		"@types/node": "26.1.2",
		"eslint": "9.39.5",
		"knip": "6.29.0",
		"nodemon": "3.1.14",
		"prettier": "3.9.6",
		"prettier-plugin-organize-imports": "4.3.0",
		"tsx": "4.23.1",
		"typescript": "5.9.3",
		"unbuild": "3.6.1"
	},
	"files": [
		"dist/",
		"shared/",
		"README.md"
	]
}
