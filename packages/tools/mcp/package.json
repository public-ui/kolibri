{
	"name": "@public-ui/mcp",
	"version": "3.1.6-rc.0",
	"license": "EUPL-1.2",
	"homepage": "https://public-ui.github.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"bugs": {
		"url": "https://github.com/public-ui/kolibri/issues",
		"email": "kolibri@itzbund.de"
	},
	"author": {
		"name": "Informationstechnikzentrum Bund",
		"email": "kolibri@itzbund.de"
	},
	"type": "module",
	"private": false,
	"description": "Model Context Protocol server providing AI agents access to 136+ KoliBri component examples and source code.",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"kolibri",
		"design-system",
		"ai-agent",
		"component-library",
		"accessibility",
		"react",
		"typescript"
	],
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"bin": {
		"@public-ui/mcp": "dist/cli.cjs",
		"kolibri-mcp": "dist/cli.cjs"
	},
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build:deps": "pnpm --filter @public-ui/mcp^... build",
		"generate-index": "node ./scripts/generate-sample-index.mjs",
		"prebuild": "pnpm generate-index",
		"build": "unbuild",
		"predev": "pnpm generate-index",
		"dev": "nodemon",
		"format": "prettier -c src test public",
		"lint": "pnpm lint:eslint && pnpm lint:tsc",
		"lint:eslint": "eslint src test",
		"lint:tsc": "tsc --noemit",
		"preinspect": "pnpm generate-index",
		"inspect": "mcp-inspector tsx src/cli.ts",
		"prestart": "pnpm build",
		"start": "node dist/mcp.cjs",
		"start:stdio": "node dist/cli.cjs",
		"pretest": "pnpm build",
		"test": "node --test test/*.test.js",
		"test:api": "node test-vercel-api.mjs",
		"unused": "knip",
		"vercel:dev": "vercel dev",
		"vercel:deploy": "vercel",
		"vercel:deploy:prod": "vercel --prod"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.29.0",
		"@public-ui/components": "workspace:*",
		"express": "5.2.1",
		"fuse.js": "7.3.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.5",
		"@eslint/js": "9.39.4",
		"@modelcontextprotocol/inspector": "0.21.2",
		"@types/express": "5.0.6",
		"@types/node": "24.12.4",
		"@typescript-eslint/eslint-plugin": "8.58.2",
		"@typescript-eslint/parser": "8.58.2",
		"eslint": "9.39.4",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-json": "3.1.0",
		"knip": "5.88.1",
		"nodemon": "3.1.14",
		"prettier": "3.8.3",
		"prettier-plugin-organize-imports": "4.3.0",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"unbuild": "3.6.1"
	},
	"files": [
		"dist/",
		"shared/",
		"README.md"
	]
}
