{
	"name": "@public-ui/benchmark-tests",
	"private": true,
	"scripts": {
		"build:deps": "pnpm --filter @public-ui/components --filter @public-ui/theme-default build",
		"format": "prettier --check tests",
		"pretest": "rimraf public/*/ && kolibri-copy-assets --dest public/assets @public-ui/components @public-ui/theme-default && kolibri-copy-assets --dest public/components @public-ui/components:dist && kolibri-copy-assets --dest public/theme @public-ui/theme-default:dist",
		"pretest-benchmark": "pnpm pretest",
		"test-benchmark": "pnpm test-with-playwright",
		"test-with-playwright": "playwright test",
		"test-with-wdio": "wdio",
		"unused": "knip"
	},
	"devDependencies": {
		"@playwright/test": "1.60.0",
		"@public-ui/components": "workspace:*",
		"@public-ui/theme-default": "workspace:*",
		"@types/mocha": "10.0.10",
		"@types/node": "25.9.2",
		"@wdio/cli": "9.27.2",
		"@wdio/globals": "9.27.2",
		"@wdio/local-runner": "9.27.2",
		"@wdio/mocha-framework": "9.27.2",
		"@wdio/spec-reporter": "9.27.2",
		"chromedriver": "148.0.4",
		"knip": "6.16.1",
		"prettier": "3.8.4",
		"prettier-plugin-organize-imports": "4.3.0",
		"rimraf": "6.1.3",
		"http-server": "14.1.1",
		"typescript": "5.9.3"
	}
}
