{
	"devDependencies": {
		"@commitlint/cli": "20.3.1",
		"@commitlint/config-conventional": "20.3.1",
		"husky": "9.1.7",
		"lerna": "9.0.3",
		"license-report": "6.8.1",
		"lint-staged": "16.2.7",
		"npm-check-updates": "19.3.1",
		"npm-run-all2": "8.0.4",
		"prettier": "3.7.4",
		"stylelint": "16.26.1",
		"stylelint-config-recommended-scss": "16.0.2",
		"stylelint-config-standard": "39.0.1",
		"stylelint-order": "7.0.1",
		"stylelint-scss": "6.14.0"
	},
	"engines": {
		"pnpm": "^10"
	},
	"pnpm": {
		"overrides": {
			"axios": "^1.12.0",
			"braces": "^3.0.3",
			"brace-expansion": ">=1.1.12",
			"form-data": "^4.0.4",
			"glob": "^11.1.0",
			"lodash.pick": "npm:lodash@^4.17.21",
			"loupe": "^2.3.7",
			"eslint-plugin-jsx-a11y>minimatch": "^3.1.2",
			"lerna>minimatch": "^3.0.5",
			"minimatch": "^9.0.5",
			"minimist": "1.2.8",
			"semver": "^7.5.2",
			"tar-fs": "^3.1.1",
			"ejs@<3.1.10": ">=3.1.10",
			"micromatch@<4.0.8": ">=4.0.8",
			"webpack@>=5.0.0-alpha.0 <5.94.0": ">=5.94.0",
			"esbuild@<=0.24.2": ">=0.25.0",
			"on-headers@<1.1.0": ">=1.1.0",
			"webpack-dev-server@<=5.2.0": ">=5.2.1",
			"tmp@<=0.2.3": ">=0.2.4",
			"nanoid@<3.3.8": ">=3.3.8",
			"min-document@<=2.19.0": ">=2.19.1",
			"js-yaml@<3.14.2": ">=3.14.2",
			"js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
			"body-parser@>=2.2.0 <2.2.1": ">=2.2.1",
			"serialize-javascript@>=6.0.0 <6.0.2": ">=6.0.2",
			"node-forge@<1.3.2": ">=1.3.2",
			"@angular/common@<19.2.16": ">=19.2.16"
		}
	},
	"private": true,
	"scripts": {
		"build": "pnpm -r build",
		"clean": "git clean -f -d -X",
		"clean:branches": "git branch --merged | grep -v \\* | xargs git branch -D",
		"clean:pnpm": "pnpm -r exec rimraf pnpm-lock.yaml && rimraf pnpm-lock.yaml && pnpm clean",
		"format": "pnpm -r format",
		"format:config": "prettier --write '*.{js,ts,json,yml,yaml}' '.*.{js,ts,json,yml,yaml}' 'packages/*/*.{js,ts,json,yml,yaml}' 'packages/*/.*.{js,ts,json,yml,yaml}' 'packages/*/tsconfig*.json' 'packages/*/*.config.{js,ts}' 'packages/*/.eslintrc.*'",
		"format:all": "prettier --write '**/*.{js,ts,json,yml,yaml,md}' '*.{js,ts,json,yml,yaml,md}' && pnpm format:config && pnpm -r format",
		"lint": "pnpm -r lint",
		"lint:eslint": "pnpm -r --no-bail lint:eslint",
		"lint:stylelint": "pnpm -r --no-bail lint:stylelint",
		"lint:tsc": "pnpm -r --no-bail lint:tsc",
		"unused": "pnpm -r unused",
		"ncu:major": "ncu && pnpm -r exec ncu",
		"ncu:minor": "ncu -t minor -u && pnpm -r exec ncu -t minor -u -x @stencil/*,@unocss/*,monaco-editor",
		"ncu:patch": "ncu -t patch -u && pnpm -r exec ncu -t patch -u -x @stencil/*,@unocss/*",
		"pack": "pnpm -r exec pnpm pack",
		"prepare": "husky",
		"reinstall": "pnpm clean:pnpm && pnpm i",
		"smoketest": "pnpm clean && pnpm i && pnpm build && pnpm format && pnpm lint && pnpm test && pnpm unused",
		"test": "pnpm -r test",
		"test-reset-and-update": "rimraf packages/themes/**/snapshots/** && pnpm test-update",
		"test-update": "pnpm -r test-update",
		"update": "pnpm ncu:minor && pnpm ncu:major",
		"version": "node scripts/update-publiccode.mjs && git add publiccode.yml"
	}
}
