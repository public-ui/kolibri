# Visual screenshots are not versioned: the baseline comes from the "Visual Baseline" workflow
# (artifact per base commit) and is reviewed per pull request – see docs/visual-review.md.
/packages/themes/*/snapshots/
/packages/unstyled/snapshots/

# in all sub folders
.playwright-mcp/
.DS_Store/
dist/
node_modules/
playwright-report/
test-results/
visual-report/
visual-baseline/
*.log
*.tgz

# lefthook installs its hooks into .git/hooks; the .husky directory is a leftover
# from the former husky setup and must not be committed.
.husky/

# Generated index files (regenerated via pnpm prebuild / pnpm generate-*-index)
/packages/tools/mcp/shared/*.json

/packages/components/src/components/*/readme.md
